---
import Study from '../../views/Study.astro'
import { studiesFor, type Project } from '../../data/projects'

export const getStaticPaths = () =>
	studiesFor('es').map((project) => ({ params: { slug: project.slug }, props: { project } }))

const { project } = Astro.props as { project: Project }
---

<Study project={project} />
