---
import Base from '../layouts/Base.astro';
import Fn from '../components/Fn.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { cv, period, yearPeriod } from '../data/cv';

const { summary, experience, earlier, stack, education, courses, languages } = cv.es;
---
<Base title="Mi CV" description="Currículum de Ilán Vivanco: CTO / Director of Engineering en EpicDevs. Experiencia, stack, formación e idiomas.">
  <section class="section cv-hero">
    <div class="container stack" style="--gap: 28px">
      <Fn name="mi_historial" as="p" />
      <h1 class="display" data-reveal>Mi CV</h1>
      <p class="lede" data-reveal data-delay="0.05">{summary}</p>
      <div class="meta mono" data-reveal data-delay="0.1">
        <span><Icon name="pin" size={16} /> {site.location}</span>
        <span><Icon name="clock" size={16} /> CET · remoto</span>
        <span><Icon name="globe" size={16} /> Español · Inglés</span>
      </div>
      <div class="ctas no-print" data-reveal data-delay="0.15">
        <a class="btn btn-primary is-down" href={site.cvPdf} download>Descargar PDF <Icon name="download" /></a>
        <button class="btn" type="button" onclick="window.print()"><Icon name="print" /> Imprimir</button>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="experiencia">
    <div class="container cv-grid">
      <h2 id="experiencia" class="side-title mono">Experiencia</h2>
      <ol class="timeline" role="list">
        {experience.map((job) => (
          <li class="job" data-reveal-group>
            <div class="job-head" data-reveal>
              <h3>{job.url ? <a href={job.url} rel="noopener">{job.org}</a> : job.org}</h3>
              {job.meta && <p class="mono job-meta">{job.meta}</p>}
            </div>
            <ol class="roles" role="list">
              {job.roles.map((r) => (
                <li class="role" data-reveal>
                  <div class="role-head">
                    <h4>{r.title}</h4>
                    <span class="mono period">{period(r)}{r.place && ` · ${r.place}`}</span>
                  </div>
                  <p>{r.highlights.join(' ')}</p>
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>

      <span aria-hidden="true"></span>
      <details class="earlier" data-reveal>
        <summary>
          <span>Antes de 2015: diseño, fotografía y los primeros sitios</span>
          <span class="toggle" aria-hidden="true"><i></i><i></i></span>
        </summary>
        <ul role="list">
          {earlier.map((e, i) => (
            <li style={`--i:${i}`}>
              <span class="mono period">{yearPeriod(e)}</span>
              <span><strong>{e.org}</strong> — {e.title}. <span class="soft">{e.text}</span></span>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </section>

  <section class="section" aria-labelledby="stack">
    <div class="container cv-grid">
      <h2 id="stack" class="side-title mono">Stack</h2>
      <div class="stack-groups" data-reveal-group>
        {stack.map((g) => (
          <div class="stack-group" data-reveal>
            <h3 class="mono">{g.group}</h3>
            <ul class="chips" role="list">
              {g.items.map((it, i) => <li class="chip" style={`--i:${i}`}>{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="formacion">
    <div class="container cv-grid">
      <h2 id="formacion" class="side-title mono">Formación e idiomas</h2>
      <div class="two" data-reveal-group>
        <ul class="plain" role="list">
          {education.map((e) => (
            <li data-reveal>
              <strong>{e.title}</strong>
              <span class="soft">{e.org}</span>
              <span class="mono period">{e.period}</span>
            </li>
          ))}
        </ul>
        <ul class="plain" role="list">
          {languages.map((l) => (
            <li data-reveal>
              <strong>{l.name}</strong>
              <span class="soft">{l.level}</span>
            </li>
          ))}
          <li data-reveal>
            <strong>Autodidacta</strong>
            <ul class="courses" role="list">
              {courses.map((c) => (
                <li class="soft">{c.org}: {c.items.join(', ')}. <span class="mono period">{c.period}</span></li>
              ))}
            </ul>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .cv-hero { padding-top: clamp(40px, 7vw, 88px); }
  .meta { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 0.875rem; color: var(--text-soft); }
  .meta span { display: inline-flex; align-items: center; gap: 8px; }
  .meta :global(svg) { color: var(--teal-hi); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  .cv-grid { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 24px clamp(32px, 5vw, 72px); }
  .side-title { font-size: 0.875rem; font-weight: 500; color: var(--yellow); letter-spacing: 0.02em; text-transform: uppercase; position: sticky; top: calc(var(--header-h) + 24px); align-self: start; }

  .timeline { margin: 0; padding: 0; display: flex; flex-direction: column; gap: 48px; }
  .job { display: flex; flex-direction: column; gap: 20px; }
  .job-head h3 { font-size: clamp(1.375rem, 2.2vw, 1.75rem); letter-spacing: -0.03em; }
  .job-head h3 a { text-decoration: none; }
  .job-head h3 a:hover { color: var(--yellow-hi); }
  .job-meta { font-size: 0.8125rem; color: var(--muted); margin-top: 6px; }
  .roles { margin: 0; padding: 0 0 0 22px; display: flex; flex-direction: column; gap: 24px; }
  .role { position: relative; display: flex; flex-direction: column; gap: 8px; }
  .role::before { content: ''; position: absolute; left: -26px; z-index: 1; top: 9px; width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 2px solid var(--teal-hi); }
  .role:first-child::before { background: var(--yellow); border-color: var(--yellow); }
  .role-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; }
  .role h4 { font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.015em; }
  .period { font-size: 0.8125rem; color: var(--muted); }
  .role p { color: var(--text-soft); max-width: 70ch; }

  .earlier { border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-raised); }
  .earlier summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; padding: 0 14px 0 22px; font-weight: 500; }
  .earlier summary::-webkit-details-marker { display: none; }
  .toggle { position: relative; flex: none; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line-strong); transition: background-color 0.3s, border-color 0.3s, transform 0.5s var(--ease-spring); }
  .toggle i { position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; margin: -0.75px 0 0 -6px; background: var(--text); border-radius: 2px; transition: transform 0.4s var(--ease-out), background-color 0.3s; }
  .toggle i + i { transform: rotate(90deg); }
  .earlier summary:hover .toggle { border-color: var(--text-soft); }
  .earlier[open] .toggle { background: var(--yellow); border-color: var(--yellow); transform: rotate(180deg); }
  .earlier[open] .toggle i { background: #0A111F; }
  .earlier[open] .toggle i + i { transform: rotate(0deg); }
  .earlier[open] li { animation: rise 0.5s var(--ease-out) both; animation-delay: calc(var(--i) * 55ms); }
  .earlier { interpolate-size: allow-keywords; }
  .earlier::details-content { block-size: 0; overflow: hidden; transition: block-size 0.5s var(--ease-out), content-visibility 0.5s allow-discrete; }
  .earlier[open]::details-content { block-size: auto; }
  @keyframes rise { from { opacity: 0; translate: 0 10px; } }

  /* Línea de tiempo que se dibuja con el scroll y puntos que aparecen */
  .roles { position: relative; border-left: 0 !important; }
  .roles::before { content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 1px; background: var(--line-strong); transform-origin: top; }
  @supports (animation-timeline: view()) {
    .roles::before { animation: draw-line linear both; animation-timeline: view(); animation-range: entry 10% cover 45%; }
  }
  @keyframes draw-line { from { transform: scaleY(0); } }
  :global(.role.is-revealing)::before, :global(.role.is-in)::before { animation: pop 0.5s var(--ease-spring) both; }
  @keyframes pop { from { transform: scale(0); } }

  /* Chips que entran escalonados */
  :global(.stack-group.is-revealing) .chip { animation: chip-in 0.45s var(--ease-out) both; animation-delay: calc(0.15s + var(--i) * 40ms); }
  @keyframes chip-in { from { opacity: 0; translate: 0 8px; scale: 0.92; } }
  .earlier ul { margin: 0; padding: 0 22px 22px; display: flex; flex-direction: column; gap: 14px; }
  .earlier li { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 16px; }
  .soft { color: var(--text-soft); }

  .stack-groups { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 32px; }
  .stack-group h3 { font-size: 0.875rem; font-weight: 500; color: var(--muted); margin-bottom: 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; }
  .chips .chip { min-height: 34px; padding: 0 14px; font-size: 0.875rem; color: var(--text); background: var(--bg-raised); transition: border-color 0.2s, color 0.2s; }
  .chips .chip:hover { border-color: var(--teal-hi); }

  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 32px; }
  .plain { margin: 0; padding: 0; display: flex; flex-direction: column; gap: 24px; }
  .plain li { display: flex; flex-direction: column; gap: 2px; }
  .plain strong { font-size: 1.125rem; font-weight: 600; }
  .courses { margin: 6px 0 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }

  @media (max-width: 820px) {
    .cv-grid { grid-template-columns: minmax(0, 1fr); }
    .cv-grid > span[aria-hidden] { display: none; }
    .side-title { position: static; }
    .earlier li { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  }
  @media print {
    .side-title { position: static; color: #111; }
    .cv-grid { grid-template-columns: 140px 1fr; }
    .earlier ul { display: flex !important; }
  }
</style>
