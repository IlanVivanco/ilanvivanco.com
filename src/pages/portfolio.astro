---
import Base from '../layouts/Base.astro'
import Fn from '../components/Fn.astro'
import Icon from '../components/Icon.astro'
import WinControls from '../components/WinControls.astro'
import { portfolioList } from '../lib/schema'
import { projects, imageFor, imageSrcset, imageVariant, shotAlt, shotPath, shotSrcset } from '../data/projects'

const filters = [
	{ label: 'todos', tag: '' },
	{ label: 'case-studies', tag: 'Case study' },
	{ label: 'migraciones', tag: 'Migración' },
	{ label: 'integraciones', tag: 'Integración' },
	{ label: 'plugins', tag: 'WP Plugin' },
	{ label: 'propios', tag: 'Producto propio' },
]
const years = projects.map((p) => Number(p.date.slice(0, 4)))
const range = `${Math.min(...years)}–${Math.max(...years)}`
---

<Base
	schemaType="CollectionPage"
	schemaMainEntity={portfolioList()}
	fullTitle="Portfolio de Ilán Vivanco | Plataformas web y WordPress"
	description="Una selección de plataformas y sitios en los que trabajé: WordPress a medida, plugins, migraciones e integraciones."
>
	<section class="section pf-hero">
		<div class="container stack" style="--gap: 22px">
			<Fn name="portfolio" as="p" />
			<h1 class="display" data-reveal>
				Trabajos
			</h1>
			<p class="lede" data-reveal data-delay="0.05">
				Algunos de los proyectos en los que trabajé, la mayoría con el equipo de EpicDevs: plataformas WordPress a
				medida, plugins, migraciones e integraciones. Abrí cualquiera para ver el detalle.
			</p>
		</div>
	</section>

	<section class="pf" aria-label="Proyectos">
		<div class="container stack" style="--gap: 28px">
			<!-- Filtro con forma de comando -->
			<div class="cmd win-frame" data-reveal>
				<div class="win-bar">
					<span class="win-title" aria-hidden="true">
						~/ilan/trabajos
					</span>
					<WinControls />
				</div>
				<div class="cmd-body win-body">
					<!-- prettier-ignore -->
					<p class="cmd-line mono" aria-hidden="true"><span class="t-pr">$</span> ls trabajos<span class="cmd-arg" data-cmd-arg></span><span class="win-cursor"></span></p>
					<div class="cmd-filters" role="group" aria-label="Filtrar proyectos">
						{filters.map((f, i) => (
							<button
								type="button"
								class="filter mono"
								data-filter={f.tag}
								data-label={f.label}
								aria-pressed={i === 0 ? 'true' : 'false'}
							>
								{i > 0 && <span aria-hidden="true">--</span>}
								{f.label}
							</button>
						))}
					</div>
					<p class="cmd-out mono" aria-live="polite">
						<span class="t-arrow" aria-hidden="true">
							→
						</span>{' '}
						<strong data-count>{projects.length}</strong> proyectos · <span data-range>{range}</span>
					</p>
				</div>
			</div>

			<!-- Índice -->
			<ol class="index" role="list" data-index>
				{projects.map((p, i) => (
					<li class="item" data-item data-tags={p.tags.join('|')} data-year={p.date.slice(0, 4)}>
						<details class="row" name="trabajos">
							<summary
								class="row-head"
								data-preview={imageVariant(p, 720)}
								data-name={p.name}
								data-year={p.date.slice(0, 4)}
								data-i={i}
							>
								<span class="row-year mono">{p.date.slice(0, 4)}</span>
								<span class="row-name">{p.name}</span>
								<span class="row-tags mono">{p.tags.slice(0, 3).join(' · ')}</span>
								<span class="row-toggle" aria-hidden="true">
									<i></i>
									<i></i>
								</span>
							</summary>
							<div class="row-body">
								<img
									src={imageFor(p)}
									srcset={imageSrcset(p)}
									sizes="(max-width: 860px) calc(100vw - 40px), 560px"
									alt={`Captura de ${p.name}`}
									loading="lazy"
									decoding="async"
									width="960"
									height="600"
								/>
								<div class="row-info">
									<p class="mono row-meta">
										{p.period} · <span class="client">{p.role}</span>
									</p>
									<p class="row-desc">{p.description}</p>
									<ul class="tags" role="list">
										{p.tags.map((t) => (
											<li class="chip">{t}</li>
										))}
									</ul>
									<div class="row-actions">
										{p.study && (
											<a class="btn btn-sm" href={`/portfolio/${p.slug}`}>
												Ver el caso <Icon name="arrow-up-right" size={16} />
											</a>
										)}
										{p.post && (
											<a class="btn btn-sm" href={p.post}>
												Leer el post <Icon name="arrow-up-right" size={16} />
											</a>
										)}
										{p.url && (
											<a class="btn btn-sm" href={p.url} target="_blank" rel="noopener">
												{p.urlLabel ?? 'Visitar el sitio'} <Icon name="arrow-up-right" size={16} />
												<span class="sr-only"> (abre en otra pestaña)</span>
											</a>
										)}
									</div>
								</div>
								{p.gallery && (
									<div class="row-gallery">
										{p.gallery.map((file) => (
											<img
												src={shotPath(p, file)}
												srcset={shotSrcset(p, file)}
												sizes="(max-width: 860px) calc(100vw - 40px), 400px"
												alt={shotAlt(p, file)}
												loading="lazy"
												decoding="async"
												width="1440"
												height="900"
											/>
										))}
										{p.galleryNote && <p class="mono row-note">{p.galleryNote}</p>}
									</div>
								)}
							</div>
						</details>
					</li>
				))}
			</ol>
		</div>

		<!-- Vista previa flotante (solo con mouse) -->
		<div class="preview" data-preview-box aria-hidden="true">
			<div class="preview-card">
				<div class="preview-bar">
					<i></i>
					<i></i>
					<i></i>
					<span class="preview-cap mono" data-preview-cap></span>
				</div>
				<div class="preview-img" data-preview-imgs></div>
			</div>
		</div>
	</section>

	<script>
		const items = [...document.querySelectorAll<HTMLElement>('[data-item]')]
		const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')]
		const count = document.querySelector('[data-count]')
		const rangeEl = document.querySelector('[data-range]')
		const arg = document.querySelector<HTMLElement>('[data-cmd-arg]')
		const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

		/* ---------- Filtro ---------- */
		let typing = 0
		let lastFilter = 0
		const typeArg = async (text: string) => {
			if (!arg) return
			const id = ++typing
			if (reduce) {
				arg.textContent = text
				return
			}
			while (arg.textContent && id === typing) {
				arg.textContent = arg.textContent.slice(0, -1)
				await new Promise((r) => setTimeout(r, 12))
			}
			for (let i = 1; i <= text.length && id === typing; i++) {
				arg.textContent = text.slice(0, i)
				await new Promise((r) => setTimeout(r, 28))
			}
		}

		const apply = (tag: string) => {
			const ys: number[] = []
			items.forEach((li) => {
				const show = !tag || (li.dataset.tags || '').split('|').includes(tag)
				li.hidden = !show
				if (show) ys.push(Number(li.dataset.year))
				else li.querySelector('details')?.removeAttribute('open')
			})
			if (count) count.textContent = String(ys.length)
			if (rangeEl) rangeEl.textContent = ys.length ? `${Math.min(...ys)}–${Math.max(...ys)}` : ''
			buttons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.filter || '') === tag)))
		}

		buttons.forEach((b) =>
			b.addEventListener('click', async () => {
				const tag = b.dataset.filter || ''
				if (b.getAttribute('aria-pressed') === 'true') return
				buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)))
				const id = ++lastFilter
				// 1) se "tipea" el comando  2) se ejecuta: la lista se reordena
				await typeArg(tag ? ` --type=${b.dataset.label}` : '')
				// Si mientras tanto se eligió otro filtro, gana ese
				if (id !== lastFilter) return
				// Solo se animan las filas: una View Transition congela toda la página, nav incluido
				const before = new Map(items.filter((li) => !li.hidden).map((li) => [li, li.getBoundingClientRect().top]))
				apply(tag)
				if (reduce) return
				items
					.filter((li) => !li.hidden)
					.forEach((li) => {
						const old = before.get(li)
						const frames =
							old === undefined
								? [{ opacity: 0 }, { opacity: 1 }]
								: [{ translate: `0 ${old - li.getBoundingClientRect().top}px` }, { translate: '0 0' }]
						li.animate(frames, { duration: 450, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' })
					})
			})
		)

		/* ---------- Vista previa que sigue al cursor ---------- */
		const box = document.querySelector<HTMLElement>('[data-preview-box]')
		const imgs = document.querySelector<HTMLElement>('[data-preview-imgs]')
		const index = document.querySelector<HTMLElement>('[data-index]')
		const fine = matchMedia('(hover: hover) and (pointer: fine)').matches

		if (box && imgs && index && fine && !reduce) {
			const cap = box.querySelector<HTMLElement>('[data-preview-cap]')!
			const cache = new Map<string, HTMLImageElement>()
			const getImg = (src: string) => {
				let im = cache.get(src)
				if (!im) {
					im = new Image()
					im.src = src
					im.alt = ''
					im.decoding = 'async'
					imgs.append(im)
					cache.set(src, im)
				}
				return im
			}

			let x = innerWidth / 2,
				y = innerHeight / 2,
				tx = x,
				ty = y,
				rot = 0,
				active = false,
				raf = 0
			let current: HTMLImageElement | null = null
			let currentIdx = -1
			let px = 0.5 // posición horizontal dentro de la fila, para el paneo de la imagen

			const loop = () => {
				const dx = tx - x
				x += dx * 0.16
				y += (ty - y) * 0.16
				rot += (Math.max(-8, Math.min(8, dx * 0.08)) - rot) * 0.12
				box.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${rot}deg)`
				box.style.setProperty('--pan', `${((px - 0.5) * -8).toFixed(2)}%`)
				if (active || Math.abs(dx) > 0.5) raf = requestAnimationFrame(loop)
				else raf = 0
			}
			const start = () => {
				if (!raf) raf = requestAnimationFrame(loop)
			}

			const swap = (head: HTMLElement) => {
				const im = getImg(head.dataset.preview!)
				if (im === current) return
				const idx = Number(head.dataset.i)
				const dir = idx > currentIdx ? 'down' : 'up'
				current?.classList.remove('is-on')
				current?.setAttribute('data-leave', dir)
				im.removeAttribute('data-leave')
				im.setAttribute('data-enter', dir)
				void im.offsetWidth
				im.classList.add('is-on')
				im.removeAttribute('data-enter')
				current = im
				currentIdx = idx
				cap.textContent = `${head.dataset.year} · ${head.dataset.name}`
				cap.classList.remove('is-new')
				void cap.offsetWidth
				cap.classList.add('is-new')
			}

			index.addEventListener('pointermove', (e) => {
				tx = e.clientX
				ty = e.clientY
				const head = (e.target as HTMLElement).closest<HTMLElement>('summary[data-preview]')
				const details = head?.parentElement as HTMLDetailsElement | undefined
				const show = !!head && !details?.open
				if (show) {
					const r = head!.getBoundingClientRect()
					px = (e.clientX - r.left) / r.width
					swap(head!)
					if (!active) {
						x = tx
						y = ty
					}
				}
				active = show
				box.classList.toggle('is-visible', show)
				start()
			})
			index.addEventListener('pointerleave', () => {
				active = false
				box.classList.remove('is-visible')
			})
			index.addEventListener(
				'toggle',
				() => {
					box.classList.remove('is-visible')
					active = false
				},
				true
			)
		}
	</script>
</Base>

<style>
	.pf-hero {
		padding-top: clamp(40px, 7vw, 88px);
		padding-bottom: 28px;
	}
	.pf {
		padding-bottom: clamp(64px, 9vw, 112px);
		position: relative;
	}

	/* Comando */
	.cmd-body {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.cmd-line {
		color: var(--text);
	}
	.t-pr {
		color: var(--teal-hi);
	}
	.t-arrow {
		color: var(--violet);
	}
	.cmd-arg {
		color: var(--yellow);
		white-space: pre;
	}
	.cmd-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 6px;
		margin-inline: -8px;
	}
	/* Opciones de comando: rectas y sin bordes, como el resto de las consolas */
	.filter {
		display: inline-flex;
		align-items: center;
		min-height: 36px;
		padding: 0 8px;
		border: 0;
		background: transparent;
		color: var(--muted);
		font-size: 0.875rem;
		cursor: pointer;
		font-variant-ligatures: none;
		transition:
			background-color 0.15s,
			color 0.15s;
	}
	.filter:hover {
		color: var(--text);
	}
	.filter:focus-visible {
		border-radius: 0;
		outline: 1px solid var(--line-strong);
		outline-offset: 0;
	}
	.filter[aria-pressed='true'] {
		background: var(--yellow);
		color: #070c17;
		font-weight: 500;
	}
	.cmd-out {
		font-size: 0.875rem;
		color: var(--muted);
	}
	.cmd-out strong {
		color: var(--text);
		font-weight: 500;
	}

	/* Índice */
	.index {
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}
	.item {
		border-bottom: 1px solid var(--line);
	}
	.item[hidden] {
		display: none;
	}

	.row-head {
		position: relative;
		isolation: isolate;
		list-style: none;
		cursor: pointer;
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr) auto 32px;
		align-items: center;
		gap: 20px;
		min-height: 76px;
		padding: 14px 12px;
	}
	.row-head::-webkit-details-marker {
		display: none;
	}
	.row-head::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: 0;
		background: linear-gradient(90deg, var(--surface), color-mix(in oklab, var(--surface) 30%, transparent));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.55s var(--ease-out);
	}
	.row-head:hover::before,
	.row[open] .row-head::before,
	.row-head:focus-visible::before {
		transform: scaleX(1);
	}
	.row-year {
		font-size: 0.875rem;
		color: var(--muted);
		transition: color 0.3s;
	}
	.row-name {
		font-size: clamp(1.125rem, 1.8vw, 1.5rem);
		font-weight: 600;
		letter-spacing: -0.035em;
		line-height: 1.1;
		color: var(--text-soft);
		transition:
			transform 0.5s var(--ease-out),
			color 0.3s;
	}
	.row-head:hover .row-name,
	.row-head:focus-visible .row-name,
	.row[open] .row-name {
		color: var(--text);
	}
	.row-head:focus-visible {
		outline-offset: -2px;
		border-radius: 0;
	}
	.row-tags {
		font-size: 0.8125rem;
		color: var(--muted);
		text-align: right;
		transition: color 0.3s;
	}
	.row-head:hover .row-year,
	.row[open] .row-year {
		color: var(--yellow);
	}
	.row-head:hover .row-name {
		transform: translateX(10px);
	}
	.row-head:hover .row-tags {
		color: var(--text-soft);
	}

	.row-toggle {
		position: relative;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		border: 1px solid var(--line-strong);
		transition:
			background-color 0.3s,
			border-color 0.3s,
			transform 0.5s var(--ease-spring);
	}
	.row-toggle i {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 12px;
		height: 1.5px;
		margin: -0.75px 0 0 -6px;
		background: var(--text);
		border-radius: 2px;
		transition:
			transform 0.4s var(--ease-out),
			background-color 0.3s;
	}
	.row-toggle i + i {
		transform: rotate(90deg);
	}
	.row-head:hover .row-toggle {
		border-color: var(--text-soft);
	}
	.row[open] .row-toggle {
		background: var(--yellow);
		border-color: var(--yellow);
		transform: rotate(180deg);
	}
	.row[open] .row-toggle i {
		background: #0a111f;
	}
	.row[open] .row-toggle i + i {
		transform: rotate(0deg);
	}

	/* Apertura animada (Chrome 131+, el resto abre sin animación) */
	.row {
		interpolate-size: allow-keywords;
	}
	.row::details-content {
		block-size: 0;
		overflow: hidden;
		transition:
			block-size 0.5s var(--ease-out),
			content-visibility 0.5s allow-discrete;
	}
	.row[open]::details-content {
		block-size: auto;
	}

	.row-body {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: 28px;
		padding: 8px 12px 32px 88px;
	}
	.row-body img {
		width: 100%;
		height: auto;
		border-radius: 12px;
		border: 1px solid var(--line-hi);
	}
	.row[open] .row-body > * {
		animation: rise 0.6s var(--ease-out) both;
	}
	.row[open] .row-body > * + * {
		animation-delay: 0.08s;
	}
	@keyframes rise {
		from {
			opacity: 0;
			translate: 0 12px;
		}
	}
	.row-info {
		display: flex;
		flex-direction: column;
		gap: 14px;
		align-items: flex-start;
	}
	.row-meta {
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.client {
		color: var(--teal-hi);
	}
	.row-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.row-gallery {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 12px;
	}
	.row-note {
		grid-column: 1 / -1;
		margin: 0;
		font-size: 0.8rem;
		color: var(--muted);
	}
	.row-desc {
		color: var(--text-soft);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0;
		padding: 0;
	}

	/* Vista previa flotante */
	.preview {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 40;
		pointer-events: none;
		will-change: transform;
	}
	.preview-card {
		width: 340px;
		margin: -110px 0 0 32px;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--line-hi);
		background: var(--bg-raised);
		box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.8);
		opacity: 0;
		transform: scale(0.85);
		transform-origin: left center;
		transition:
			opacity 0.25s var(--ease-out),
			transform 0.4s var(--ease-spring);
	}
	.preview.is-visible .preview-card {
		opacity: 1;
		transform: none;
	}
	.preview-bar {
		display: flex;
		align-items: center;
		gap: 5px;
		padding: 7px 10px;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}
	.preview-bar i {
		flex: none;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--line-strong);
	}
	.preview-img {
		position: relative;
		aspect-ratio: 16 / 10;
	}
	.preview-img {
		overflow: hidden;
	}
	.preview-img :global(img) {
		position: absolute;
		inset: -6%;
		width: 112%;
		height: 112%;
		max-width: none;
		object-fit: cover;
		opacity: 0;
		transform: translate(var(--pan, 0), 0) scale(1.06);
		transition:
			opacity 0.4s var(--ease-out),
			transform 0.7s var(--ease-out),
			clip-path 0.6s var(--ease-out);
		clip-path: inset(0 0 0 0);
	}
	.preview-img :global(img.is-on) {
		opacity: 1;
		transform: translate(var(--pan, 0), 0) scale(1);
		animation: kenburns 7s ease-in-out infinite alternate;
	}
	.preview-img :global(img[data-enter='down']) {
		transition: none;
		clip-path: inset(100% 0 0 0);
		transform: translate(var(--pan, 0), 8%) scale(1.06);
	}
	.preview-img :global(img[data-enter='up']) {
		transition: none;
		clip-path: inset(0 0 100% 0);
		transform: translate(var(--pan, 0), -8%) scale(1.06);
	}
	.preview-img :global(img[data-leave='down']) {
		transform: translate(var(--pan, 0), -6%) scale(1.04);
	}
	.preview-img :global(img[data-leave='up']) {
