---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
}
const { title, description = site.description, jsonLd } = Astro.props;
const pageTitle = title ? `${title} — Ilán Vivanco` : site.title;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ilán Vivanco',
  url: site.url,
  jobTitle: 'CTO / Director of Engineering',
  worksFor: { '@type': 'Organization', name: 'EpicDevs', url: 'https://epicdevs.com' },
  address: { '@type': 'PostalAddress', addressLocality: 'Santander', addressRegion: 'Cantabria', addressCountry: 'ES' },
  sameAs: site.socials.filter((s) => s.label !== 'EpicDevs').map((s) => s.href),
  knowsAbout: ['WordPress', 'JavaScript', 'Astro', 'Vue', 'React', 'Node.js', 'Arquitectura web', 'IA aplicada a la ingeniería'],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0A111F" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fira-code.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content="Ilán Vivanco" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Marca JS antes del primer paint; si las animaciones no cargan en 2.5 s, se muestra todo.
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!document.documentElement.classList.contains('ui-ready')) document.documentElement.classList.remove('js');
      }, 2500);
    </script>
    <script type="speculationrules" is:inline>
      { "prerender": [{ "where": { "href_matches": "/*" }, "eagerness": "moderate" }] }
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd ?? person)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
