---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Analytics from '../components/Analytics.astro'
import { site, siteText } from '../data/site'
import { ogPath, publicPages } from '../data/pages'
import { ui } from '../i18n'
import { pageSchema, type PageSchemaType } from '../lib/schema'

interface Props {
	title?: string
	// Reemplaza el <title> completo, sin el sufijo. El H1 no cambia.
	fullTitle?: string
	description?: string
	schemaType?: PageSchemaType
	schemaMainEntity?: Record<string, unknown>
	noindex?: boolean
	ogType?: 'website' | 'article'
}
const {
	title,
	fullTitle,
	description,
	schemaType,
	schemaMainEntity,
	noindex: noindexProp = false,
	ogType = 'website',
} = Astro.props
const lang = Astro.currentLocale
const t = ui(lang)
const text = siteText(lang)
const metaDescription = description ?? text.description
const pageTitle = fullTitle ?? (title ? `${title} | Ilán Vivanco` : text.title)
const pathname = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/'
const canonical = new URL(pathname, site.url).href
const ogImage = new URL(ogPath(pathname), site.url).href
const noindex = noindexProp || publicPages.find((p) => p.path === pathname)?.noindex
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{pageTitle}</title>
		<meta name="description" content={metaDescription} />
		<meta name="author" content={site.name} />
		{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
		<meta name="theme-color" content="#0A111F" />
		<meta name="color-scheme" content="dark" />

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/fira-code.woff2" as="font" type="font/woff2" crossorigin />
		<slot name="head" />

		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content={t.ogLocale} />
		<meta property="og:site_name" content="Ilán Vivanco" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={pageTitle} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:creator" content="@IlanVivanco" />

		<script is:inline>
			// Marca JS antes del primer paint; si las animaciones no cargan en 2.5 s, se muestra todo.
			document.documentElement.classList.add('js')
			setTimeout(function () {
				if (!document.documentElement.classList.contains('ui-ready'))
					document.documentElement.classList.remove('js')
			}, 2500)
		</script>
		<script type="speculationrules" is:inline>
			{
				"prerender": [
					{
						"where": { "and": [{ "href_matches": "/*" }, { "not": { "href_matches": "/cv/*" } }] },
						"eagerness": "moderate"
					}
				]
			}
		</script>
		{!noindex && (
			<script
				type="application/ld+json"
				set:html={JSON.stringify(
					pageSchema({
						pathname,
						lang,
						title: pageTitle,
						description: metaDescription,
						type: schemaType,
						mainEntity: schemaMainEntity,
					})
				)}
			/>
		)}
		<Analytics />
	</head>
	<body>
		<a class="skip-link" href="#contenido">
			{t.skipLink}
		</a>
		<Header />
		<main id="contenido">
			<slot />
		</main>
		<Footer />
		<script>
			import '../scripts/ui.ts'
		</script>
	</body>
</html>
