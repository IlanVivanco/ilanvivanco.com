---
// Isotipo "V" del sitio original (tres trazos: amarillo, teal, navy).
interface Props {
	size?: number
	class?: string
	animate?: boolean
}
const { size = 32, class: className = '', animate = false } = Astro.props
const uid = `iv${Math.random().toString(36).slice(2, 7)}`
---

<svg
	class:list={['logo', className]}
	width={size}
	height={Math.round((size * 40) / 57)}
	viewBox="0 0 57 40"
	aria-hidden="true"
	data-logo-anim={animate ? '' : undefined}
>
	<defs>
		<linearGradient id={`${uid}y`} x1=".5" x2=".5" y2=".714" gradientUnits="objectBoundingBox">
			<stop offset="0" stop-color="#ffe356" />
			<stop offset="1" stop-color="#d8bd2d" />
		</linearGradient>
		<linearGradient id={`${uid}n`} x1=".5" x2=".5" y2=".714" gradientUnits="objectBoundingBox">
			<stop offset="0" stop-color="#6d82a8" />
			<stop offset="1" stop-color="#475b7d" />
		</linearGradient>
		<linearGradient id={`${uid}t`} x1=".5" x2=".5" y2=".714" gradientUnits="objectBoundingBox">
			<stop offset="0" stop-color="#55c9d1" />
			<stop offset="1" stop-color="#2c979f" />
		</linearGradient>
	</defs>
	<path
		data-stroke
		fill={`url(#${uid}y)`}
		d="M26.639 40H16.99a5.09 5.09 0 01-4.83-3.482L0 0h9.646a5.1 5.1 0 014.834 3.486z"
	/>
	<path
		data-stroke
		fill={`url(#${uid}t)`}
		d="M43.092 40h-9.646a5.1 5.1 0 01-4.835-3.486L16.453 0H26.1a5.091 5.091 0 014.83 3.482z"
	/>
	<path data-stroke fill={`url(#${uid}n)`} d="M56.411 0L43.092 40l-6.659-20 5.5-16.516A5.089 5.089 0 0146.76 0z" />
</svg>
