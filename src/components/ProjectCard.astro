---
import type { Project } from '../data/projects'
import { imageFor, imageSrcset } from '../data/projects'
import { ui } from '../i18n'
import Icon from './Icon.astro'

interface Props {
	project: Project
	headingLevel?: 'h2' | 'h3'
}
const { project: p, headingLevel: H = 'h3' } = Astro.props
const { card: t, externalNote } = ui(Astro.currentLocale)
// Con case study, la tarjeta lleva a su página; si no, al sitio.
const href = p.study ? `/portfolio/${p.slug}` : p.url
const external = !p.study && Boolean(p.url)
const Tag = href ? 'a' : 'article'
---

<Tag
	class="card project"
	data-tilt
	href={href}
	target={external ? '_blank' : undefined}
	rel={external ? 'noopener' : undefined}
	data-reveal
>
	<div class="shot">
		<img
			src={imageFor(p)}
			srcset={imageSrcset(p)}
			sizes="(max-width: 960px) calc(100vw - 40px), 560px"
			alt={`${t.shot} ${p.name}`}
			loading="lazy"
			decoding="async"
			width="960"
			height="600"
		/>
		{href && (
			<span class="shot-cta mono" aria-hidden="true">
				{p.study ? t.study : t.visit} <Icon name="arrow-up-right" size={16} />
			</span>
		)}
	</div>
	<div class="body">
		<p class="meta mono">
			<span>{p.period}</span>
		</p>
		<H class="name">
			{p.name}
			{external && <span class="sr-only">{externalNote}</span>}
		</H>
		<p class="desc">{p.description}</p>
		<ul class="tags" role="list">
			{p.tags.map((t) => (
				<li class="chip">{t}</li>
			))}
		</ul>
	</div>
</Tag>

<style>
	.project {
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.shot {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-bottom: 1px solid var(--line);
		background: var(--surface);
		border-radius: calc(var(--radius) - 1px) calc(var(--radius) - 1px) 0 0;
	}
	.shot img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: grayscale(0.7) brightness(0.72) contrast(1.05);
		transform: scale(1.02);
		transition:
			filter 0.6s var(--ease-out),
			transform 0.9s var(--ease-out);
	}
	.shot::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(180deg, rgba(10, 17, 31, 0) 40%, rgba(10, 17, 31, 0.75) 100%), rgba(32, 46, 73, 0.35);
		mix-blend-mode: normal;
		transition: opacity 0.5s var(--ease-out);
	}
	.shot-cta {
		position: absolute;
		right: 14px;
		bottom: 14px;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 32px;
		padding: 0 12px;
		border-radius: 999px;
		background: var(--yellow);
		color: #0a111f;
		font-size: 0.8125rem;
		font-weight: 500;
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity 0.35s var(--ease-out),
			transform 0.45s var(--ease-spring);
	}
	.project:hover .shot img,
	.project.is-hover .shot img,
	.project:focus-visible .shot img {
		filter: none;
		transform: scale(1.07);
	}
	.project:hover .shot::after,
	.project.is-hover .shot::after,
	.project:focus-visible .shot::after {
		opacity: 0;
	}
	.project:hover .shot-cta,
	.project.is-hover .shot-cta,
	.project:focus-visible .shot-cta {
		opacity: 1;
		transform: none;
	}

	.body {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 22px 24px 24px;
		flex-grow: 1;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 14px;
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.client {
		color: var(--teal-hi);
	}
	.name {
		font-size: 1.375rem;
		letter-spacing: -0.025em;
	}
	.desc {
		color: var(--text-soft);
		flex-grow: 1;
		font-size: 0.9875rem;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 6px 0 0;
		padding: 0;
	}

	@media (hover: none) {
		.shot img {
			filter: none;
		}
		.shot::after {
			opacity: 0.4;
		}
	}
</style>
