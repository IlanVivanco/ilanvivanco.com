---
import Logo from './Logo.astro'
import Socials from './Socials.astro'
const year = new Date().getFullYear()
---

<footer class="site-footer">
	<div class="container foot">
		<div class="foot-brand">
			<span class="foot-id">
				<Logo size={26} />
				<span class="foot-name">ilán vivanco</span>
			</span>
			<span class="foot-note">© {year} · hecho en Santander con Astro y café</span>
		</div>
		<a href="/privacidad">Privacidad y aviso legal</a>
		<Socials />
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
	}
	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 32px;
		padding-block: 28px;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.foot-brand {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.foot-id {
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}
	.foot-name {
		color: var(--text-soft);
	}
	@media (max-width: 640px) {
		.foot {
			flex-direction: column;
			justify-content: center;
			gap: 12px;
			text-align: center;
		}
		.foot-brand {
			flex-direction: column;
			gap: 8px;
		}
		.foot-note {
			text-wrap: balance;
		}
		.foot-name {
			color: var(--text);
			font-family: var(--font-sans);
			font-size: 1.125rem;
			font-weight: 600;
		}
	}
	a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		text-decoration: none;
		color: var(--text-soft);
	}
	a:hover {
		color: var(--yellow-hi);
	}
</style>
