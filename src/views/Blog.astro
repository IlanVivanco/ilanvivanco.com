---
import Base from '../layouts/Base.astro'
import Fn from '../components/Fn.astro'
import { coverSrcset, formatPostDate, posts } from '../data/posts'
---

<Base
	title="Blog"
	description="Lo que aprendí construyendo para la web, con los errores incluidos: WordPress, equipos, deploys e IA en el trabajo de todos los días."
	schemaType="CollectionPage"
>
	<link slot="head" rel="alternate" type="application/rss+xml" title="Blog de Ilán Vivanco" href="/rss.xml" />
	<section class="section blog">
		<div class="container stack" style="--gap: 16px">
			<Fn name="blog" as="p" />
			<h1 class="display" data-reveal>
				Blog
			</h1>
			<p class="lede">Lo que aprendí construyendo para la web, con los errores incluidos.</p>
			<ul class="posts" role="list" data-reveal data-delay="0.1">
				{posts.map((p, i) => (
					<li>
						<div class="cover">
							<img
								src={p.image}
								srcset={coverSrcset(p)}
								sizes="(max-width: 640px) calc(100vw - 40px), 280px"
								alt={p.imageAlt}
								loading={i === 0 ? undefined : 'lazy'}
								fetchpriority={i === 0 ? 'high' : undefined}
								decoding="async"
								width="1440"
								height="900"
							/>
						</div>
						<div class="info">
							<time class="mono" datetime={p.date}>
								{formatPostDate(p.date)}
							</time>
							<h2 class="h3">
								<a href={`/blog/${p.slug}`}>{p.title}</a>
							</h2>
							<p>{p.description}</p>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>
</Base>

<style>
	.blog {
		padding-top: clamp(40px, 7vw, 88px);
	}
	.posts {
		display: flex;
		flex-direction: column;
		margin: 24px 0 0;
		padding: 0;
		max-width: 900px;
		border-top: 1px solid var(--line);
	}
	.posts li {
		position: relative;
		display: grid;
		grid-template-columns: 280px minmax(0, 1fr);
		gap: 28px;
		align-items: center;
		padding-block: 28px;
		border-bottom: 1px solid var(--line);
	}
	.cover {
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 12px;
		line-height: 0;
	}
	.cover img {
		width: 100%;
		height: auto;
		filter: grayscale(0.7) brightness(0.72) contrast(1.05);
		transition:
			filter 0.5s var(--ease-out),
			scale 0.7s var(--ease-out);
	}
	.posts li:hover img,
	.posts li:has(a:focus-visible) img {
		filter: none;
		scale: 1.04;
	}
	.info {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.posts time {
		color: var(--muted);
		font-size: 0.8125rem;
	}
	.posts h2 {
		margin: 0;
	}
	.posts h2 a {
		color: var(--text);
		text-decoration: none;
		transition: color 0.2s;
	}
	/* Toda la fila lleva al post */
	.posts h2 a::after {
		content: '';
		position: absolute;
		inset: 0;
	}
	.posts li:hover h2 a,
	.posts h2 a:focus-visible {
		color: var(--yellow-hi);
	}
	.posts p {
		margin: 0;
		max-width: 70ch;
		color: var(--text-soft);
	}
	@media (max-width: 640px) {
		.posts li {
			grid-template-columns: minmax(0, 1fr);
			gap: 16px;
		}
	}
</style>
