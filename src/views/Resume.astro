---
import Base from '../layouts/Base.astro'
import Fn from '../components/Fn.astro'
import Icon from '../components/Icon.astro'
import { siteText } from '../data/site'
import { cv, period, stackIcons, yearPeriod } from '../data/cv'

const lang = Astro.currentLocale === 'en' ? 'en' : 'es'
const { summary, experience, earlier, stack, education, languages } = cv[lang] ?? cv.es
const { location, cvPdf } = siteText(lang)
// Cada tecnología con ícono, en el orden del stack. Los ítems "A / B" se separan.
const techIcons = stack
	.flatMap((g) => g.items.flatMap((item) => item.split(' / ')))
	.filter((label) => stackIcons[label])
---

<Base
	fullTitle="CV de Ilán Vivanco | CTO y Director of Engineering"
	description="Currículum de Ilán Vivanco: CTO / Director of Engineering en EpicDevs. Experiencia, stack, formación e idiomas."
>
	<section class="section cv-hero">
		<div class="container stack" style="--gap: 28px">
			<Fn name="mi_historial" as="p" />
			<h1 class="display" data-reveal>
				Mi CV
			</h1>
			<p class="lede">{summary}</p>
			<div class="meta mono" data-reveal data-delay="0.1">
				<span>
					<Icon name="map-pin" size={16} /> {location}
				</span>
				<span>
					<Icon name="clock" size={16} /> CET · remoto
				</span>
				<span>
					<Icon name="globe" size={16} /> Español · Inglés
				</span>
			</div>
			<div class="ctas no-print" data-reveal data-delay="0.15">
				<a class="btn btn-primary is-down" href={cvPdf} download>
					Descargar PDF <Icon name="download" />
				</a>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="experiencia">
		<div class="container cv-grid">
			<h2 id="experiencia" class="side-title mono">
				Experiencia
			</h2>
			<ol class="timeline" role="list">
				{experience.map((job) => (
					<li class="job" data-reveal-group>
						<div class="job-head" data-reveal>
							<h3>
								{job.url ? (
									<a class="link" href={job.url} target="_blank" rel="noopener">
										{job.org}
									</a>
								) : (
									job.org
								)}
							</h3>
							{job.meta && <p class="mono job-meta">{job.meta}</p>}
						</div>
						<ol class="roles" role="list">
							{job.roles.map((r) => (
								<li class:list={['role', { now: !r.end }]} data-reveal>
									<div class="role-head">
										<h4>{r.title}</h4>
										<span class="mono period">
											{period(r, lang)}
											{r.place && ` · ${r.place}`}
										</span>
									</div>
									<p>{r.highlights.join(' ')}</p>
								</li>
							))}
						</ol>
					</li>
				))}
			</ol>

			<span aria-hidden="true"></span>
			<details class="earlier" data-reveal>
				<summary>
					<span>Antes de 2015: diseño, fotografía y los primeros sitios</span>
					<span class="toggle" aria-hidden="true">
						<i></i>
						<i></i>
					</span>
				</summary>
				<ul role="list">
					{earlier.map((e, i) => (
						<li style={`--i:${i}`}>
							<span class="mono period">{yearPeriod(e)}</span>
							<span>
								<strong>{e.org}</strong> · {e.title}. <span class="soft">{e.text}</span>
							</span>
						</li>
					))}
				</ul>
			</details>
		</div>
	</section>

	<section class="section" aria-labelledby="stack">
		<div class="container cv-grid">
			<h2 id="stack" class="side-title mono">
				Stack
			</h2>
			<div class="stack-block">
				<ul class="tech" role="list" data-reveal>
					{techIcons.map((label) => (
						<li class="tech-item" tabindex="0">
							<Icon name={stackIcons[label] as 'wordpress'} size={24} title={label} />
							<span class="tech-tip mono" aria-hidden="true">
								{label}
							</span>
						</li>
					))}
				</ul>
				<dl class="stack-list" data-reveal-group>
					{stack.map((g) => (
						<div class="stack-row" data-reveal>
							<dt class="mono">{g.group}</dt>
							<dd>{g.items.join(', ')}</dd>
						</div>
					))}
				</dl>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="formacion">
		<div class="container cv-grid">
			<h2 id="formacion" class="side-title mono">
				Formación e idiomas
			</h2>
			<div class="two" data-reveal-group>
				<ul class="plain" role="list">
					{education.map((e) => (
						<li data-reveal>
							<strong>{e.title}</strong>
							<span class="soft">{e.org}</span>
							<span class="mono period">{e.period}</span>
						</li>
					))}
				</ul>
				<ul class="plain" role="list">
					{languages.map((l) => (
						<li data-reveal>
							<strong>{l.name}</strong>
							<span class="soft">{l.level}</span>
						</li>
					))}
				</ul>
			</div>
		</div>
	</section>
</Base>

<script>
	// WCAG 1.4.13: Escape cierra el tooltip sin mover el foco ni el puntero
	const lists = document.querySelectorAll<HTMLElement>('.tech')
	const show = (on: boolean) => lists.forEach((l) => l.classList.toggle('is-dismissed', !on))
	document.addEventListener('keydown', (e) => e.key === 'Escape' && show(false))
	// Corre el tooltip lo justo para que no se corte en el borde de la pantalla
	const fit = (tip: HTMLElement | null | undefined) => {
		if (!tip) return
		tip.style.removeProperty('--shift')
		const { left, right } = tip.getBoundingClientRect()
		const edge = document.documentElement.clientWidth - 8
		const shift = left < 8 ? 8 - left : right > edge ? edge - right : 0
		if (shift) tip.style.setProperty('--shift', `${shift}px`)
	}
	lists.forEach((l) =>
		['pointerover', 'focusin'].forEach((type) =>
			l.addEventListener(type, (e) => {
				show(true)
				fit((e.target as HTMLElement).closest('.tech-item')?.querySelector<HTMLElement>('.tech-tip'))
			})
		)
	)
</script>

<style>
	.cv-hero {
		padding-top: clamp(40px, 7vw, 88px);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 24px;
		font-size: 0.875rem;
		color: var(--text-soft);
	}
	.meta span {
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.meta :global(svg) {
		color: var(--teal-hi);
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.cv-grid {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		gap: 24px clamp(32px, 5vw, 72px);
	}
	.side-title {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--yellow);
		letter-spacing: 0.02em;
		text-transform: uppercase;
		position: sticky;
		top: calc(var(--header-h) + 24px);
		align-self: start;
	}

	.timeline {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 48px;
	}
	.job {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.job-head h3 {
		font-size: clamp(1.375rem, 2.2vw, 1.75rem);
		letter-spacing: -0.03em;
	}
	.job-meta {
		font-size: 0.8125rem;
		color: var(--muted);
		margin-top: 6px;
	}
	.roles {
		margin: 0;
		padding: 0 0 0 22px;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.role {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.role::before {
		content: '';
		position: absolute;
		left: -26px;
		z-index: 1;
		top: 9px;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--teal-hi);
	}
	.role.now::before {
		background: var(--yellow);
		border-color: var(--yellow);
	}
	.role-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 4px 16px;
	}
	.role h4 {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}
	.period {
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.role p {
		color: var(--text-soft);
		max-width: 70ch;
	}

	.earlier {
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--bg-raised);
	}
	.earlier summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		min-height: 60px;
		padding: 14px 22px;
		font-weight: 500;
	}
	.earlier summary::-webkit-details-marker {
		display: none;
	}
	.toggle {
		position: relative;
		flex: none;
		width: 32px;
		height: 32px;
		border-radius: 50%;
		border: 1px solid var(--line-strong);
		transition:
			background-color 0.3s,
			border-color 0.3s,
			transform 0.5s var(--ease-spring);
	}
	.toggle i {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 12px;
		height: 1.5px;
		margin: -0.75px 0 0 -6px;
		background: var(--text);
		border-radius: 2px;
		transition:
			transform 0.4s var(--ease-out),
			background-color 0.3s;
	}
	.toggle i + i {
		transform: rotate(90deg);
	}
	.earlier summary:hover .toggle {
		border-color: var(--text-soft);
	}
	.earlier[open] .toggle {
		background: var(--yellow);
		border-color: var(--yellow);
		transform: rotate(180deg);
	}
	.earlier[open] .toggle i {
		background: #0a111f;
	}
	.earlier[open] .toggle i + i {
		transform: rotate(0deg);
	}
	.earlier[open] li {
		animation: rise 0.5s var(--ease-out) both;
		animation-delay: calc(var(--i) * 55ms);
	}
	.earlier {
		interpolate-size: allow-keywords;
	}
	.earlier::details-content {
		block-size: 0;
		overflow: hidden;
		transition:
			block-size 0.5s var(--ease-out),
			content-visibility 0.5s allow-discrete;
	}
	.earlier[open]::details-content {
		block-size: auto;
	}
	@keyframes rise {
		from {
			opacity: 0;
			translate: 0 10px;
		}
	}

	/* Línea de tiempo que se dibuja con el scroll y puntos que aparecen */
	.roles {
		position: relative;
		border-left: 0 !important;
	}
	.roles::before {
		content: '';
		position: absolute;
		left: 0;
		top: 6px;
		bottom: 6px;
		width: 1px;
		background: var(--line-strong);
		transform-origin: top;
	}
	@supports (animation-timeline: view()) {
		.roles::before {
			animation: draw-line linear both;
			animation-timeline: view();
			animation-range: entry 10% cover 45%;
		}
	}
	@keyframes draw-line {
		from {
			transform: scaleY(0);
		}
	}
	:global(.role.is-revealing)::before,
	:global(.role.is-in)::before {
		animation: pop 0.5s var(--ease-spring) both;
	}
	@keyframes pop {
		from {
			transform: scale(0);
		}
	}

	.earlier ul {
		margin: 0;
		padding: 4px 22px 22px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.earlier li {
		display: grid;
		grid-template-columns: 110px minmax(0, 1fr);
		gap: 16px;
		/* La fecha es más chica que el texto: se alinean por la línea base */
		align-items: baseline;
	}
	.soft {
		color: var(--text-soft);
	}

	/* Grilla de íconos y lista de texto: las pastillas parecían links o filtros */
	.stack-block {
		display: flex;
		flex-direction: column;
		gap: 24px;
		min-width: 0;
	}
	.stack-list {
		margin: 0;
		border-top: 1px solid var(--line);
	}
	.stack-row {
		display: grid;
		grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
		gap: 4px 24px;
		padding-block: 14px;
		border-bottom: 1px solid var(--line);
	}
	.stack-row dt {
		font-size: 0.875rem;
		line-height: 1.9;
		color: var(--muted);
	}
	.stack-row dd {
		margin: 0;
		color: var(--text-soft);
	}
	.tech {
		display: grid;
		grid-template-columns: repeat(10, minmax(0, 1fr));
		gap: 8px;
		justify-items: start;
		margin: 0 0 0 -6px;
		padding: 0;
	}
	.tech-item {
		position: relative;
		display: flex;
		padding: 6px;
		border-radius: 6px;
		transition: color 0.15s;
	}
	/* Sin hover en el svg: su <title> es para lectores de pantalla y no debe sumar el tooltip nativo */
	.tech-item :global(svg) {
		pointer-events: none;
	}
	.tech-item:hover,
	.tech-item:focus {
		color: var(--yellow-hi);
	}
	.tech-tip {
		position: absolute;
		bottom: 100%;
		left: 50%;
		z-index: 5;
		padding: 4px 8px;
		border: 1px solid var(--line-hi);
		border-radius: 6px;
		background: var(--bg-raised);
		color: var(--text);
		font-size: 0.75rem;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		translate: calc(-50% + var(--shift, 0px)) 0;
		transition: opacity 0.15s;
	}
	.tech-item:hover .tech-tip,
	.tech-item:focus .tech-tip {
		opacity: 1;
	}
	/* WCAG 1.4.13: con mouse se puede pasar al tooltip. En táctil no captura toques: taparía al ícono de arriba */
	@media (hover: hover) {
		.tech-item:hover .tech-tip {
			pointer-events: auto;
		}
	}
	.tech.is-dismissed .tech-tip {
		opacity: 0;
		pointer-events: none;
	}
	.two {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
		gap: 32px;
	}
	.plain {
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.plain li {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.plain strong {
		font-size: 1.125rem;
		font-weight: 600;
	}

	@media (max-width: 820px) {
		.stack-row {
			grid-template-columns: minmax(0, 1fr);
		}
		.tech {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}
		.cv-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.cv-grid > span[aria-hidden] {
			display: none;
		}
		.side-title {
			position: static;
		}
		.earlier li {
			grid-template-columns: minmax(0, 1fr);
			gap: 4px;
		}
	}
	@media print {
		.side-title {
			position: static;
			color: #111;
		}
		.cv-grid {
			grid-template-columns: 140px 1fr;
		}
		.earlier ul {
			display: flex !important;
		}
	}
</style>
