---
import Base from '../layouts/Base.astro'
import Fn from '../components/Fn.astro'
import Icon from '../components/Icon.astro'
import { studiesFor, shotAlt, shotPath, shotSrcset, imageFor, type Project } from '../data/projects'
import { site } from '../data/site'

interface Props {
	project: Project
}
const { project: p } = Astro.props
const s = p.study!
const lang = Astro.currentLocale
const studies = studiesFor(lang)
const next = studies[(studies.findIndex((x) => x.slug === p.slug) + 1) % studies.length]
const fn = p.slug.replace(/-/g, '_')
---

<Base
	title={`${p.name}: ${s.tagline}`}
	description={p.description}
	schemaMainEntity={{
		'@type': 'CreativeWork',
		'name': p.name,
		'description': p.description,
		'image': new URL(imageFor(p), site.url).href,
		'keywords': p.tags.join(', '),
		...(p.url && { url: p.url }),
	}}
>
	<article class="section study">
		<div class="container stack" style="--gap: 22px">
			<a class="back mono" href="/portfolio">
				← trabajos
			</a>
			<Fn name={fn} as="p" />
			<h1 class="display" data-reveal>
				{p.name}
			</h1>
			<p class="mono meta" data-reveal>
				{s.tagline} · {p.period}
			</p>
			<p class="lede">{s.lead}</p>
			<dl class="facts" data-reveal data-delay="0.1">
				<div>
					<dt class="mono">Mi rol</dt>
					<dd>{p.role}</dd>
				</div>
				<div>
					<dt class="mono">Stack</dt>
					<dd>{s.stack.join(', ')}</dd>
				</div>
			</dl>
			{p.url && (
				<div>
					<a class="btn btn-sm" href={p.url} target="_blank" rel="noopener">
						{p.urlLabel ?? 'Visitar el sitio'} <Icon name="arrow-up-right" size={16} />
						<span class="sr-only"> (abre en otra pestaña)</span>
					</a>
				</div>
			)}
			<img
				class="shot"
				src={shotPath(p, s.hero)}
				srcset={shotSrcset(p, s.hero)}
				sizes="(max-width: 1180px) calc(100vw - 40px), 1120px"
				alt={shotAlt(p, s.hero, lang)}
				fetchpriority="high"
				decoding="async"
				width="1440"
				height="900"
			/>

			<h2 class="title">El punto de partida</h2>
			<p class="text">{s.start}</p>

			<h2 class="title">Qué hicimos</h2>
			{s.steps.map((step) => (
				<section class="step stack" style="--gap: 12px">
					<h3>{step.title}</h3>
					<p class="text">{step.text}</p>
					{step.shot && (
						<img
							class="shot"
							src={shotPath(p, step.shot)}
							srcset={shotSrcset(p, step.shot)}
							sizes="(max-width: 1180px) calc(100vw - 40px), 1120px"
							alt={shotAlt(p, step.shot, lang)}
							loading="lazy"
							decoding="async"
							width="1440"
							height="900"
						/>
					)}
				</section>
			))}

			<h2 class="title">En números</h2>
			<ul class="figures" role="list">
				{s.figures.map((f) => (
					<li class="chip">{f}</li>
				))}
			</ul>

			<a class="next" href={`/portfolio/${next.slug}`}>
				<span class="mono">Siguiente caso</span>
				<strong>
					{next.name} <Icon name="arrow-up-right" size={16} />
				</strong>
			</a>
		</div>
	</article>
</Base>

<style>
	.back,
	.meta {
		color: var(--muted);
		font-size: 0.9rem;
	}
	.back:hover {
		color: var(--text);
	}
	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 18px;
		margin: 0;
	}
	.facts dt {
		color: var(--muted);
		font-size: 0.82rem;
	}
	.facts dd {
		margin: 4px 0 0;
		color: var(--text-soft);
	}
	.shot {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--line);
		border-radius: var(--radius);
	}
	.title {
		margin: 28px 0 0;
		font-size: 1.6rem;
	}
	.step h3 {
		margin: 0;
		font-size: 1.15rem;
	}
	.text {
		margin: 0;
		max-width: 70ch;
		color: var(--text-soft);
	}
	.figures {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
	}
	.next {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-top: 28px;
		padding-top: 22px;
		border-top: 1px solid var(--line);
		color: var(--text);
		text-decoration: none;
	}
	.next span {
		color: var(--muted);
		font-size: 0.85rem;
	}
	.next:hover strong {
		color: var(--accent, inherit);
	}
</style>
