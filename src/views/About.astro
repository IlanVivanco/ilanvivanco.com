---
import Base from '../layouts/Base.astro'
import Fn from '../components/Fn.astro'
import Icon from '../components/Icon.astro'
import InstagramGrid from '../components/InstagramGrid.astro'
import { pathFor } from '../data/pages'
import { ui } from '../i18n'

const lang = Astro.currentLocale
const t = ui(lang).about
---

<Base schemaType="ProfilePage" title={t.title} description={t.description}>
	<section class="section sm-hero">
		<div class="container sm-hero-grid">
			<div class="stack" style="--gap: 22px">
				<Fn name={t.fn} as="p" />
				<h1 class="display" data-reveal>
					{t.title}
				</h1>
				<p class="lede">{t.lede}</p>
			</div>
			<figure class="sm-photo" data-reveal data-delay="0.1">
				<img
					src="/img/ilan-480.webp"
					srcset="/img/ilan-480.webp 480w, /img/ilan-800.webp 800w"
					sizes="(max-width: 820px) 60vw, 300px"
					width="480"
					height="600"
					alt={t.photoAlt}
					decoding="async"
				/>
			</figure>
		</div>
	</section>

	<section class="section" aria-labelledby="historia">
		<div class="container sm-grid">
			<h2 id="historia" class="side mono">
				{t.story}
			</h2>
			<div class="prose stack" style="--gap: 20px" data-reveal>
				<p>{t.storyStart}</p>
				<p>{t.storyWp}</p>
				<!-- prettier-ignore -->
				<p>
					{t.storyNowBefore} <a class="link" href="https://epicdevs.com" target="_blank" rel="noopener">EpicDevs</a>{t.storyNowAfter}
				</p>
				<p>{t.storySelf}</p>
			</div>
		</div>
	</section>

	<section class="section" aria-labelledby="recorrido">
		<div class="container sm-grid">
			<h2 id="recorrido" class="side mono">
				{t.journey}
			</h2>
			<ol class="route" role="list" data-reveal-group>
				{t.route.map((r, i) => (
					<li class="card stop" data-tilt data-reveal>
						<span class="mono idx">0{i + 1}</span>
						<div class="stack" style="--gap: 6px">
							<h3>{r.place}</h3>
							<span class="mono when">{r.when}</span>
							<p>{r.text}</p>
						</div>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section" aria-labelledby="fuera">
		<div class="container sm-grid">
			<h2 id="fuera" class="side mono">
				{t.outside}
			</h2>
			<div class="outside">
				<div class="prose stack" style="--gap: 20px" data-reveal>
					<p>{t.family}</p>
					<p>{t.desk}</p>
					<p>{t.site}</p>
					<div class="ctas">
						<a class="btn btn-primary" href={pathFor('/contacto', lang)}>
							{t.talk} <Icon name="arrow-up-right" />
						</a>
						<a class="btn" href={pathFor('/curriculum', lang)}>
							{t.cv} <Icon name="arrow-right" />
						</a>
					</div>
				</div>
				<figure class="workspace card" data-tilt data-reveal data-delay="0.1">
					<img
						src="/img/workspace-640.webp"
						srcset="/img/workspace-400.webp 400w, /img/workspace-640.webp 640w"
						sizes="(max-width: 820px) calc(100vw - 60px), 400px"
						width="640"
						height="854"
						loading="lazy"
						decoding="async"
						alt={t.deskAlt}
					/>
					<figcaption class="mono">{t.deskCaption}</figcaption>
				</figure>
				<InstagramGrid />
			</div>
		</div>
	</section>
</Base>

<style>
	.sm-hero {
		padding-top: clamp(40px, 7vw, 88px);
	}
	.sm-hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: 32px clamp(32px, 6vw, 80px);
		align-items: end;
	}
	.sm-photo {
		margin: 0;
		aspect-ratio: 4 / 5;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid var(--line-hi);
		rotate: 2deg;
		transition: rotate 0.6s var(--ease-spring);
	}
	.sm-photo:hover {
		rotate: 0deg;
	}
	.sm-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: saturate(0.85);
	}
	.outside {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
		gap: 32px clamp(32px, 5vw, 64px);
		align-items: start;
	}
	.workspace {
		margin: 0;
		padding: 10px;
	}
	.workspace img {
		border-radius: 8px;
		width: 100%;
		height: auto;
	}
	.workspace figcaption {
		padding: 10px 4px 2px;
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.sm-grid {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		gap: 24px clamp(32px, 5vw, 72px);
	}
	.side {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--yellow);
		text-transform: uppercase;
		letter-spacing: 0.02em;
		position: sticky;
		top: calc(var(--header-h) + 24px);
		align-self: start;
	}
	.prose {
		max-width: 68ch;
		font-size: 1.125rem;
		color: var(--text-soft);
	}
	.prose a:not(.btn):not(:hover) {
		color: var(--text);
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: 8px;
	}

	.route {
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
		gap: 16px;
		counter-reset: stop;
	}
	.stop {
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.stop .idx {
		font-size: 0.8125rem;
		color: var(--teal-hi);
	}
	.stop h3 {
		font-size: 1.25rem;
		letter-spacing: -0.025em;
	}
	.stop .when {
		font-size: 0.8125rem;
		color: var(--muted);
	}
	.stop p {
		color: var(--text-soft);
	}
	.stop:last-child {
		border-color: color-mix(in oklab, var(--yellow) 45%, var(--line));
	}
	.stop:last-child .idx {
		color: var(--yellow);
	}

	@media (max-width: 820px) {
		.sm-hero-grid,
		.outside {
			grid-template-columns: minmax(0, 1fr);
		}
		.sm-photo {
			width: min(70%, 280px);
		}
		.sm-grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.side {
			position: static;
		}
	}
</style>
